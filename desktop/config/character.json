{
  "_comment": "换虚拟形象只改这个文件 + 换图片。mode=static 表示单帧立绘；mode=sheet 表示 sprite sheet 动画。",
  "name": "HKU 卫衣男孩",
  "mode": "static",
  "sprite": "../../frontend/public/assets/mascot/front.png",
  "displayHeight": 150,
  "animations": {
    "_comment": "以后生成动画帧后，在这里按行配置，mode 改回 sheet 即可",
    "idle": {
      "row": 0,
      "frames": 4,
      "fps": 2,
      "loop": true
    }
  },
  "defaultAnimation": "idle",
  "interaction": {
    "click": "openMainWindow",
    "doubleClick": "playBlink",
    "drag": true,
    "rightClick": "showMenu"
  },
  "window": {
    "width": 96,
    "height": 96,
    "opacityWhenIdle": 1.0
  }
}
