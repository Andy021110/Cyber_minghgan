# Cyber Minghan environment template
# Copy to .env and fill in. DO NOT commit real secrets.

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
MODEL=deepseek-v4-pro

# Optional overrides
# KG_PATH=./yuanbao_cyber_minghan_kg.json
# EPI_PATH=./memory/episodic/cyber_minghan_live.jsonl

# ── 邮件适配器（赛博明翰 · mail/）────────────────────────────
# 口令不是登录密码：Gmail 用「应用专用密码」，163 用「授权码」
# 获取方式见 .env.example 注释下方说明

# Gmail：Google 账号 → 安全性 → 两步验证 → 应用专用密码
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# 163：网页版 → 设置 → POP3/SMTP/IMAP → 开启 IMAP/SMTP → 生成授权码
NETEASE_ADDRESS=
NETEASE_AUTH_CODE=
